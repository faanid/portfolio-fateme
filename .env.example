# Yahoo SMTP credentials used to email contact-form, project-submission,
# and project-comment form data. Use a Yahoo "app password", not your
# regular account password: https://help.yahoo.com/kb/SLN15241.html
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_USER=your-yahoo-address@yahoo.com
SMTP_PASSWORD=your-yahoo-app-password

# Address that receives the emails sent from the site's forms
CONTACT_RECEIVER_EMAIL=your-receiving-address@example.com
